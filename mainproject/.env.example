# ==========================================
# IntelliGrade Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# ==========================================

# ==========================================
# Django Core Settings
# ==========================================
DJANGO_SECRET_KEY=django-insecure-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_SITE_URL=http://127.0.0.1:8000
DJANGO_PUBLIC_URL=http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False

# ==========================================
# Database Configuration (Environment-Aware)
# ==========================================
# 1. For Local Development (SQLite):
DB_ENGINE=sqlite

# 2. For Production / cPanel (PostgreSQL):
# Uncomment and configure the lines below for PostgreSQL deployments:
# DB_ENGINE=postgresql
# DB_NAME=your_cpanel_db_name
# DB_USER=your_cpanel_db_user
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ==========================================
# AI Provider API Keys & Settings
# ==========================================
DEFAULT_AI_PROVIDER=GROQ
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ==========================================
# OCR & Vision Pipeline Settings
# ==========================================
EASYOCR_GPU=False
EASYOCR_CPU_THREADS=4
EASYOCR_MAX_DIMENSION=1800
EASYOCR_MODEL_STORAGE_DIRECTORY=
EASYOCR_MODULE_PATH=
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
