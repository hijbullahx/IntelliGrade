{
  "project_name": "IntelliGrade",
  "version": "3.0",
  "django_app": "core",
  "installed_apps": [
    "django.contrib.admin",
    "django.contrib.auth",
    "django.contrib.contenttypes",
    "django.contrib.sessions",
    "django.contrib.messages",
    "django.contrib.staticfiles",
    "core.apps.CoreConfig"
  ],
  "pipelines": {
    "exam_routine_scanner": {
      "entry_endpoint": "/controller/scan-routine-ai/",
      "view_function": "core.views.scan_routine_ai",
      "service": "core.ai_engine.routine_parser.routine_parser.RoutineParser",
      "ai_provider": "FailoverAIProvider",
      "ocr_fallback": "OCREngineManager / PyMuPDF / EasyOCR"
    },
    "question_paper_scanner": {
      "entry_endpoint": "/controller/scan-question-ai/",
      "view_function": "core.views.scan_question_paper",
      "service": "core.ai_engine.document_service.DocumentService",
      "parser": "core.ai_engine.parser.academic_parser.AcademicParserService",
      "ai_provider": "FailoverAIProvider"
    },
    "student_answer_script_pipeline": {
      "entry_endpoint": "/evaluate/upload/",
      "view_function": "core.views.upload_submission",
      "mapping_service": "core.ai_engine.mapping.orchestrator.QuestionMappingOrchestrator",
      "evaluator_service": "core.ai_engine.evaluation.script_evaluator.AIScriptEvaluator",
      "heading_detector": "core.ai_engine.mapping.question_number_detector.StudentQuestionHeadingDetector"
    }
  },
  "configuration": {
    "central_config_package": "config",
    "path_resolver": "config.paths",
    "runtime_detector": "config.runtime_config",
    "ai_config": "config.ai_config",
    "ocr_config": "config.ocr_config",
    "scanner_config": "config.scanner_config",
    "evaluation_config": "config.evaluation_config"
  }
}
