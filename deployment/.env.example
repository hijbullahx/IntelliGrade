# ============================================================
# INTELLIGRADE GLOBAL ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env or reference via INTELLIGRADE_ENV_FILE
# ============================================================

# Django Core Security & Runtime Settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.pythonanywhere.com,.app.github.dev
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://localhost:8000,https://127.0.0.1:8000,https://*.app.github.dev
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_SITE_URL=
DJANGO_PUBLIC_URL=
DJANGO_SECURE_SSL_REDIRECT=False

# Primary AI Provider Credentials & Selection
DEFAULT_AI_PROVIDER=GROQ

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud API Configuration
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Hardware Acceleration & Processing Thresholds
EASYOCR_GPU=auto
EASYOCR_CPU_THREADS=1
EASYOCR_MAX_DIMENSION=1024
EASYOCR_MODEL_STORAGE_DIRECTORY=
EASYOCR_MODULE_PATH=
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3
