# ============================================================
# INTELLIGRADE GLOBAL ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env or reference via INTELLIGRADE_ENV_FILE
# ============================================================

# Django Core Security & Runtime Settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=.pythonanywhere.com,localhost,127.0.0.1,*

# Primary AI Provider Credentials & Selection
DEFAULT_AI_PROVIDER=GROQ

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud API Configuration
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Hardware Acceleration & Processing Thresholds
EASYOCR_GPU=auto
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3
